{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.campuslynk.net/json-schemas/setup-state.schema.json",
  "title": "SetupState",
  "description": "First-run setup wizard state tracking step completion, finalization timestamp, and per-section post-completion unlocks.",
  "type": "object",
  "properties": {
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "object",
      "properties": {
        "institution_profile": {
          "type": "object",
          "properties": {
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "calendar_basics": {
          "type": "object",
          "properties": {
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "signup_policy": {
          "type": "object",
          "properties": {
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "unlocks": {
      "type": "object",
      "properties": {
        "institution_profile": {
          "$ref": "#/$defs/sectionUnlock"
        },
        "calendar_basics": {
          "$ref": "#/$defs/sectionUnlock"
        },
        "signup_policy": {
          "$ref": "#/$defs/sectionUnlock"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "sectionUnlock": {
      "type": "object",
      "properties": {
        "unlocked_by_user_id": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26
        },
        "unlocked_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        }
      },
      "required": [
        "unlocked_by_user_id",
        "unlocked_at",
        "expires_at",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
