{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.campuslynk.net/json-schemas/calendar-basics.schema.json",
  "title": "CalendarBasics",
  "description": "Tenant academic calendar basics: working days, periods per day, period timings, and day order format.",
  "type": "object",
  "properties": {
    "working_days": {
      "type": "array",
      "description": "Array of unique weekday names (1-7 days)",
      "items": {
        "type": "string"
      }
    },
    "periods_per_day": {
      "type": "integer",
      "description": "Total instructional periods scheduled per working day (1-12)",
      "minimum": 1,
      "maximum": 12
    },
    "periods": {
      "type": "array",
      "description": "Ordered array of period timing definitions ({index, start, end})",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "start": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          }
        },
        "required": [
          "index",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "day_order_format": {
      "type": "string",
      "description": "Day order cycle numbering representation",
      "enum": [
        "roman",
        "numeric",
        "alpha"
      ]
    }
  },
  "required": [
    "working_days",
    "periods_per_day",
    "periods",
    "day_order_format"
  ],
  "additionalProperties": false
}

