{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.academic-suite.com/json-schemas/tenant-branding.schema.json",
  "title": "TenantBranding",
  "description": "Strict schema for tenant branding tokens matching packages/ui branding contract.",
  "type": "object",
  "properties": {
    "light": {
      "type": "object",
      "description": "Light theme color tokens",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
        },
        "primaryForeground": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
        },
        "ring": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
        }
      },
      "required": [
        "primary",
        "primaryForeground"
      ],
      "additionalProperties": false
    },
    "dark": {
      "type": "object",
      "description": "Dark theme color tokens",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
        },
        "primaryForeground": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
        },
        "ring": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
        }
      },
      "required": [
        "primary",
        "primaryForeground"
      ],
      "additionalProperties": false
    },
    "primary": {
      "type": "string",
      "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
    },
    "primaryForeground": {
      "type": "string",
      "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
    },
    "ring": {
      "type": "string",
      "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\([^;{}\\n]+\\))$"
    },
    "logoUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?:\\/\\/[^\\s$.?#].[^\\s]*$"
    }
  },
  "required": [
    "light",
    "dark"
  ],
  "additionalProperties": false
}
