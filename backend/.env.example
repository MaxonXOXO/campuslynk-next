# -----------------------------------------------------------------------------
# Academic Suite Backend Environment Configuration
# -----------------------------------------------------------------------------

# Application Profile: 'onprem' (appliance mode) or 'cloud' (multi-tenant cloud SaaS)
DEPLOY_PROFILE=onprem

APP_NAME="Academic Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (PostgreSQL via PgBouncer)
# DB_PORT 6432 points to PgBouncer; direct Postgres runs on 5432
DB_CONNECTION=unconfigured
DB_HOST=127.0.0.1
DB_PORT=6432
DB_DATABASE=unconfigured_db
DB_USERNAME=unconfigured_user
DB_PASSWORD=
DB_SSLMODE=prefer

# Landlord Database Connection (used by central platform and tenant resolver)
LANDLORD_DB_HOST=127.0.0.1
LANDLORD_DB_PORT=6432
LANDLORD_DB_DATABASE=landlord
LANDLORD_DB_USERNAME=landlord_app
LANDLORD_DB_PASSWORD=

# Admin Direct PostgreSQL Connection (used only for provisioning DDL in app/Core/Tenancy)
ADMIN_DB_HOST=127.0.0.1
ADMIN_DB_PORT=5432
ADMIN_DB_DATABASE=landlord
ADMIN_DB_USERNAME=provisioner
ADMIN_DB_PASSWORD=

# Redis Cache & Queue
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=academic_suite_

# Cache / Queue / Session drivers
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Mail (queued delivery)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@campuslynk.in"
MAIL_FROM_NAME="${APP_NAME}"

