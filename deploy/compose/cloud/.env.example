# -----------------------------------------------------------------------------
# Cloud SaaS Docker Compose Environment Configuration
# -----------------------------------------------------------------------------

# Deployment Profile
DEPLOY_PROFILE=cloud

# Application Key
APP_KEY=

# Exposed Ports
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379

# URLs
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# PostgreSQL Credentials
DB_USERNAME=academic_suite
DB_PASSWORD=

