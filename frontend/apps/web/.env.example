# Next.js Server Component internal backend API URL (Docker network)
INTERNAL_API_URL=http://api:8000

# Client-side public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000


# Server-only: same-origin auth/proxy layer (no secrets here)
BACKEND_BASE_URL=http://localhost:8000
TENANT_SLUG=
# Optional comma-separated extra Origins allowed for mutating requests
APP_ALLOWED_ORIGINS=
