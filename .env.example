# -----------------------------------------------------------------------------
# Academic Suite Monorepo Environment Configuration
# -----------------------------------------------------------------------------

# Deployment Profile: 'onprem' | 'cloud'
DEPLOY_PROFILE=onprem

# Backend Configuration
APP_NAME="Academic Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Ports
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379

# Database Configuration (PgBouncer connection)
DB_CONNECTION=placeholder
DB_HOST=127.0.0.1
DB_PORT=6432
DB_DATABASE=academic_suite
DB_USERNAME=academic_suite
DB_PASSWORD=

# Landlord Database
LANDLORD_DB_HOST=127.0.0.1
LANDLORD_DB_PORT=6432
LANDLORD_DB_DATABASE=landlord
LANDLORD_DB_USERNAME=academic_suite
LANDLORD_DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Frontend Configuration
INTERNAL_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
